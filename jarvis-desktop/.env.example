# Copy this file to ".env" in the same folder and fill in your own keys.
# .env is gitignored — it never gets committed, so your keys stay on your PC.

# --- Required: the brain ------------------------------------------------------
# Get one at https://console.anthropic.com -> API Keys.
# Without this, Jarvis starts but can only do the built-in offline commands.
ANTHROPIC_API_KEY=

# The model Jarvis thinks with. Do NOT change this to claude-3-5-sonnet-*:
# that model was retired on 28 Oct 2025 and now returns a 404.
JARVIS_MODEL=claude-sonnet-5

# --- Optional: the ElevenLabs voice -------------------------------------------
# Leave ELEVENLABS_API_KEY blank and Jarvis speaks with the Windows built-in
# voice instead (free, offline, no account). Fill it in for the good voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=wDsJlOXPqcvIUKdLXjDs
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Safety -------------------------------------------------------------------
# Off by default, and it should stay off until you have watched Jarvis work.
# When false, Jarvis asks you to approve every action that changes anything on
# your PC (opening apps, typing, closing windows) before it happens.
JARVIS_AUTO_APPROVE=false

# Microphone wake word. Say this before a command when the mic is on.
JARVIS_WAKE_WORD=jarvis
