# OpenRouter API key — get one at https://openrouter.ai/settings/keys
# Calls Claude Opus 5 via OpenRouter's OpenAI-compatible API rather than Anthropic
# directly. Note: OpenRouter requires purchased credits (https://openrouter.ai/settings/credits)
# to actually run inference — an unfunded key will fail with a 402 at request time.
# Leave this as the placeholder (or omit it) to run in free DEMO MODE, which uses a
# rule-based mock classifier instead of calling Claude.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_REAL_KEY

# The public URL this app is reachable at once deployed (used for OpenRouter's
# analytics header, and as the OAuth redirect base + Gmail poll base when
# GOOGLE_REDIRECT_URI isn't set explicitly). Set this to your real deployed URL —
# e.g. https://your-app.up.railway.app — once you're not just running locally.
APP_URL=http://localhost:3000

# Port the server listens on
PORT=3000

# Force demo mode on even if a real API key is set above (optional)
# DEMO_MODE=true

# --- Gmail integration (Jarvis's inbox) ---------------------------------------
# One-time setup Jarvis can't do for you (needs your Google login):
#   1. https://console.cloud.google.com -> new project -> enable the "Gmail API".
#   2. OAuth consent screen -> External -> add your Gmail address as a test user.
#   3. Credentials -> Create OAuth client ID -> Web application -> add an
#      authorized redirect URI of {APP_URL}/auth/google/callback
#      (e.g. http://localhost:3000/auth/google/callback while running locally).
#   4. Paste the resulting client ID/secret below.
#   5. Start the app, visit GET /auth/google in your browser, and approve access.
#   6. In Gmail, create a label (matching GMAIL_LABEL below, default "Jarvis") and
#      a filter that applies it to whatever should count as a lead. Jarvis only
#      ever reads mail under that label — never the rest of your inbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if it should differ from {APP_URL}/auth/google/callback.
# GOOGLE_REDIRECT_URI=

# The Gmail label Jarvis watches for lead emails. Create this label (and a filter
# that applies it) in Gmail before connecting.
GMAIL_LABEL=Jarvis

# How often Jarvis checks the labeled inbox, in minutes.
GMAIL_POLL_MINUTES=5

# Off by default. When false (the default), Jarvis drafts every reply in Gmail
# for you to review and send yourself. Set to true only once you trust his
# drafts enough to let him send real email from your account with no review.
GMAIL_AUTO_SEND=false

# --- Voice HUD (LiveKit + Deepgram + ElevenLabs) ------------------------------
# All optional. With none of these set, the HUD at /hud still works completely —
# live stats, lead feed, and typed questions to Jarvis. These three only add
# talking to it out loud, and ALL THREE are needed for that (transport, ears,
# and a voice). Each is a paid service with a free tier — check current pricing
# before relying on it day to day.

# LiveKit — carries mic audio to the server and Jarvis's voice back.
# Free tier at https://cloud.livekit.io — create a project, then copy its
# websocket URL and API key/secret from the project settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — speech-to-text. Free credit at https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ElevenLabs — Jarvis's speaking voice. Free tier at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice library. Defaults to "Adam" (deep, calm).
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Where the persisted lead/activity data lives. Defaults to ./data/ — set these
# to a mounted volume path if your host wipes the working directory on deploy.
# DATA_FILE=./data/nightdesk.json
# ACTIVITY_FILE=./data/activity.json

# Which lead classifications automatically become a follow-up task on your list.
# Default "hot" — a hot lead going unactioned is the expensive failure, while
# turning every warm lead into a task would bury the real ones. Use "hot,warm"
# to widen it, or "none" to turn auto-tasks off entirely.
AUTO_TASK_FOR=hot

# Where the task list is persisted. Defaults to ./data/tasks.json
# TASKS_FILE=./data/tasks.json
