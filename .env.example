# Anthropic API key — get one at https://console.anthropic.com/
# Leave this as the placeholder (or omit it) to run in free DEMO MODE, which uses a
# rule-based mock classifier instead of calling Claude. Swap in a real key to go live.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_REAL_KEY

# Port the server listens on
PORT=3000

# Force demo mode on even if a real API key is set above (optional)
# DEMO_MODE=true
