# OpenRouter API key — get one at https://openrouter.ai/settings/keys
# Calls Claude Opus 5 via OpenRouter's OpenAI-compatible API rather than Anthropic
# directly. Note: OpenRouter requires purchased credits (https://openrouter.ai/settings/credits)
# to actually run inference — an unfunded key will fail with a 402 at request time.
# Leave this as the placeholder (or omit it) to run in free DEMO MODE, which uses a
# rule-based mock classifier instead of calling Claude.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_REAL_KEY

# Optional — sent as the HTTP-Referer header on OpenRouter requests (used for their
# analytics/rankings). Defaults to https://leadqualify.ai if unset.
APP_URL=https://leadqualify.ai

# Port the server listens on
PORT=3000

# Force demo mode on even if a real API key is set above (optional)
# DEMO_MODE=true

# Stripe secret key — get one at https://dashboard.stripe.com/apikeys (use a
# sk_test_... key while developing). Leave as the placeholder (or omit it) to run
# checkout in free BILLING DEMO MODE, which activates "purchases" instantly with
# no real payment.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_REAL_KEY

# Stripe webhook signing secret — from the webhook endpoint you register in the
# Stripe dashboard pointed at POST /stripe/webhook (use `stripe listen --forward-to
# localhost:3000/stripe/webhook` for local testing, which prints a whsec_... value).
# Only used when STRIPE_SECRET_KEY above is a real key.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_REAL_SECRET

# Optional — enables live prospect discovery in `npm run find-prospects` via
# Google's official Custom Search JSON API (not scraping search result pages).
# Get a free API key at https://console.cloud.google.com/apis/credentials and a
# Search Engine ID (cx) at https://programmablesearchengine.google.com/.
# Without these, the script still works — it just uses the bundled, manually-
# verified seed list of real agencies (scripts/prospect-seed.js) as-is.
# GOOGLE_SEARCH_API_KEY=REPLACE_WITH_YOUR_REAL_KEY
# GOOGLE_SEARCH_CX=REPLACE_WITH_YOUR_SEARCH_ENGINE_ID
